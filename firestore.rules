rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staffPath(uid) {
      return /databases/$(database)/documents/staff/$(uid);
    }
    function casePath(id) {
      return /databases/$(database)/documents/cases/$(id);
    }
    function entryPath(id, entry) {
      return /databases/$(database)/documents/cases/$(id)/entries/$(entry);
    }
    function docketPath(id) {
      return /databases/$(database)/documents/docket/$(id);
    }
    function staff() {
      return request.auth != null && exists(staffPath(request.auth.uid))
        && get(staffPath(request.auth.uid)).data.role in ['lawyer', 'prosecutor', 'judge']
        && !get(staffPath(request.auth.uid)).data.get('disabled', false);
    }
    function admin() {
      return staff() && get(staffPath(request.auth.uid)).data.get('admin', false) == true;
    }
    function validStaff(data) {
      return data.keys().hasOnly(['username', 'role', 'disabled'])
        && text(data.username, 100) && data.role in ['lawyer', 'prosecutor', 'judge']
        && data.get('disabled', false) is bool;
    }
    function role() {
      return get(staffPath(request.auth.uid)).data.role;
    }
    function hasRole(uid, expected) {
      return uid is string && exists(staffPath(uid)) && get(staffPath(uid)).data.role == expected
        && !get(staffPath(uid)).data.get('disabled', false);
    }
    function assigned(data) {
      return staff() && (data.get('creator', '') == request.auth.uid || data[role()] == request.auth.uid);
    }
    function owner(data) {
      return staff() && data.get('creator', data.prosecutor) == request.auth.uid;
    }
    function validAssignments(data) {
      return (data.prosecutor == '' || hasRole(data.prosecutor, 'prosecutor'))
        && (data.lawyer == '' || hasRole(data.lawyer, 'lawyer'))
        && (data.judge == '' || hasRole(data.judge, 'judge'));
    }
    function updatedAssignments(old, next) {
      return owner(old) && next.diff(old).affectedKeys().hasOnly(['prosecutor', 'lawyer', 'judge', 'creator'])
        && next.creator == old.get('creator', old.prosecutor) && validAssignments(next);
    }
    function open(data) {
      return data.status in ['filed', 'scheduled'];
    }
    function text(value, limit) {
      return value is string && value.size() > 0 && value.size() <= limit;
    }
    function iso(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    function validEntry(data) {
      return data.keys().hasAll(['kind', 'author', 'body', 'created'])
        && data.keys().hasOnly(['kind', 'author', 'body', 'created', 'hearing_at', 'label', 'url', 'juryStatus', 'articleId', 'articleCode', 'articleTitle', 'exhibitId', 'chargeId', 'verdict'])
        && data.author == request.auth.uid && text(data.body, 12000) && iso(data.created)
        && (data.kind == 'hearing' ? iso(data.hearing_at) : !('hearing_at' in data))
        && (data.kind in ['exhibit', 'juror'] ? text(data.label, 150) : !('label' in data))
        && (data.kind == 'exhibit'
          ? (!('url' in data) || (text(data.url, 2048) && data.url.matches('^https://.+')))
          : !('url' in data))
        && (data.kind == 'juror' ? data.juryStatus in ['candidate', 'seated', 'alternate', 'excused'] : !('juryStatus' in data))
        && (data.kind == 'charge' || !data.keys().hasAny(['articleId', 'articleCode', 'articleTitle', 'exhibitId']))
        && (data.kind == 'verdict' || !data.keys().hasAny(['chargeId', 'verdict']));
    }
    function validCharge(id, data) {
      let article = get(/databases/$(database)/documents/penal/$(data.articleId)).data;
      return text(data.articleId, 200) && text(data.articleCode, 150) && text(data.articleTitle, 300)
        && data.articleCode == article.code && data.articleTitle == article.title
        && (!('exhibitId' in data) || (text(data.exhibitId, 200)
          && get(entryPath(id, data.exhibitId)).data.kind in ['exhibit', 'evidence']));
    }
    function validVerdict(id, data) {
      return text(data.chargeId, 200) && data.verdict in ['guilty', 'not-guilty', 'dismissed']
        && get(entryPath(id, data.chargeId)).data.kind == 'charge';
    }
    function matchesPublic(id, entry) {
      let published = getAfter(docketPath(id)).data;
      return entry.kind == 'hearing'
        ? published == {'kind': 'hearing', 'hearing_at': entry.hearing_at, 'created': entry.created}
        : published == {'kind': 'publish', 'body': entry.body, 'created': entry.created};
    }
    function courtTransition(id, old, next) {
      let event = entryPath(id, next.lastEntry);
      let entry = getAfter(event).data;
      return role() == 'judge'
        && next.diff(old).affectedKeys().hasOnly(['status', 'lastEntry'])
        && next.lastEntry != old.lastEntry && !exists(event)
        && entry.author == request.auth.uid
        && (
          (open(old) && next.status == 'scheduled' && entry.kind == 'hearing' && matchesPublic(id, entry))
          || (open(old) && next.status == 'decided' && entry.kind == 'decision' && !existsAfter(docketPath(id)))
          || (old.status == 'decided' && next.status == 'published' && entry.kind == 'publish' && matchesPublic(id, entry))
        );
    }
    function linkedCourtEntry(id, eventId) {
      let old = get(casePath(id)).data;
      let next = getAfter(casePath(id)).data;
      return assigned(old) && role() == 'judge'
        && old.lastEntry != eventId && next.lastEntry == eventId;
    }

    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || staff());
      allow list: if staff();
      allow create: if admin() && validStaff(request.resource.data);
      allow update: if admin() && !resource.data.get('admin', false) && validStaff(request.resource.data);

      match /documents/{documentId} {
        function ownDocuments() {
          return staff() && request.auth.uid == uid;
        }
        allow read: if ownDocuments();
        allow create, update: if ownDocuments()
          && request.resource.data.keys().hasOnly(['title', 'body', 'updated', 'signature', 'category'])
          && text(request.resource.data.title, 150)
          && text(request.resource.data.body, 12000)
          && (!('signature' in request.resource.data) || text(request.resource.data.signature, 100))
          && (!('category' in request.resource.data) || request.resource.data.category in ['motion', 'appearance', 'letter', 'evidence', 'indictment', 'hearing', 'decision', 'other'])
          && request.resource.data.updated == request.time;
      }

    }
    match /roster/{uid} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['username', 'role'])
        && text(request.resource.data.username, 100)
        && hasRole(uid, request.resource.data.role)
        && request.resource.data.username == get(staffPath(uid)).data.username;
      allow delete: if admin();
    }
    match /applications/{id} {
      allow create: if id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['name', 'contact', 'role', 'body', 'created'])
        && text(request.resource.data.name, 100) && text(request.resource.data.contact, 120)
        && request.resource.data.role in ['lawyer', 'prosecutor', 'judge']
        && text(request.resource.data.body, 3000) && request.resource.data.created == request.time;
      allow read: if admin();
    }
    match /penal/{article} {
      allow read: if true;
    }
    match /docket/{id} {
      allow read: if true;
      allow create, update: if assigned(get(casePath(id)).data) && role() == 'judge'
        && get(casePath(id)).data.lastEntry != getAfter(casePath(id)).data.lastEntry
        && (request.resource.data.kind == 'hearing' || request.resource.data.kind == 'publish');
      allow delete: if assigned(get(casePath(id)).data) && role() == 'judge'
        && open(get(casePath(id)).data) && getAfter(casePath(id)).data.status == 'decided';
    }
    match /cases/{id} {
      allow read: if assigned(resource.data);
      allow create: if staff()
        && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['title', 'defendant', 'prosecutor', 'lawyer', 'judge', 'status', 'lastEntry', 'creator'])
        && text(request.resource.data.title, 150) && text(request.resource.data.defendant, 100)
        && (('creator' in request.resource.data)
          ? request.resource.data.creator == request.auth.uid && validAssignments(request.resource.data)
          : role() == 'prosecutor' && request.resource.data.prosecutor == request.auth.uid
            && hasRole(request.resource.data.lawyer, 'lawyer') && hasRole(request.resource.data.judge, 'judge'))
        && request.resource.data.status == 'filed'
        && getAfter(entryPath(id, request.resource.data.lastEntry)).data.kind == 'indictment';
      allow update: if (assigned(resource.data) && courtTransition(id, resource.data, request.resource.data))
        || updatedAssignments(resource.data, request.resource.data);

      match /entries/{entry} {
        allow read: if assigned(get(casePath(id)).data);
        allow create: if staff() && validEntry(request.resource.data) && (
          (request.resource.data.kind == 'indictment' && !exists(casePath(id))
            && owner(getAfter(casePath(id)).data)
            && getAfter(casePath(id)).data.lastEntry == entry)
          || (request.resource.data.kind in ['motion', 'evidence'] && assigned(get(casePath(id)).data)
            && open(getAfter(casePath(id)).data)
            && (request.resource.data.kind == 'motion' ? role() == 'lawyer' : role() == 'prosecutor'))
          || (request.resource.data.kind in ['exhibit', 'juror'] && assigned(get(casePath(id)).data)
            && open(getAfter(casePath(id)).data) && (request.resource.data.kind == 'exhibit' || role() == 'judge'))
          || (assigned(get(casePath(id)).data) && open(getAfter(casePath(id)).data)
            && ((role() == 'prosecutor' && request.resource.data.kind == 'charge' && validCharge(id, request.resource.data))
              || (role() == 'judge' && request.resource.data.kind == 'verdict' && validVerdict(id, request.resource.data))))
          || (request.resource.data.kind in ['hearing', 'decision', 'publish'] && linkedCourtEntry(id, entry))
        );
      }
      match /privateNotes/{uid}/items/{entry} {
        allow read: if staff() && role() == 'lawyer' && request.auth.uid == uid && assigned(get(casePath(id)).data);
        allow create: if staff() && role() == 'lawyer' && request.auth.uid == uid
          && assigned(get(casePath(id)).data) && open(getAfter(casePath(id)).data)
          && validEntry(request.resource.data) && request.resource.data.kind == 'note';
      }
    }
  }
}
